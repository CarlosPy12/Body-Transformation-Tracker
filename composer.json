{
  "name": "carlo/body-transformation-tracker",
  "description": "PWA PHP/MySQL per monitoraggio trasformazione corporea, GLP-1, passi e allenamenti.",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "google/apiclient": "^2.16",
    "minishlink/web-push": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
